release          = "<git-sha>"
artifacts_bucket = "founder-signal-dev-artifacts-<account-id>"
email_from       = "letters@example.com"
# alert_email      = "you@example.com"
# api_domain_name     = "api.example.com"
# api_certificate_arn = "arn:aws:acm:ap-southeast-2:<account-id>:certificate/<id>"

# Connect YouTube (docs/imports/README.md): the Google OAuth web client ID. The secret goes in
# Secrets Manager (founder-signal/dev/google-oauth-client-secret). Empty turns it off.
# google_oauth_client_id = "1234-abc.apps.googleusercontent.com"

# Newsletters by email (docs/imports/README.md): a domain or subdomain you control, e.g. "in.example.com".
# Applying creates the SES identity, receipt rule, mail bucket and worker; then add the records from
# `terraform output inbound_email_dns_records`. Leave empty to keep it off.
inbound_email_domain = ""
