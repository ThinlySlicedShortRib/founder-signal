# Local development (copy to .env)
DATABASE_URL=postgres://fs:fs@localhost:5433/founder_signal
BETTER_AUTH_SECRET=change-me-to-a-32-plus-char-random-string
BETTER_AUTH_URL=http://localhost:8787
# Where OTP emails go: "console" (dev) or "ses"
EMAIL_TRANSPORT=console
EMAIL_FROM=letters@example.com
# Where mobile error reports go: "console" (dev) or "cloudwatch"
CLIENT_LOG_SINK=console
CLIENT_LOG_GROUP=/founder-signal/dev/mobile
# Ingestion (M1). Optional locally: without them YouTube links are refused
# and videos are saved without a transcript.
YOUTUBE_API_KEY=
SUPADATA_API_KEY=
# Extracted content goes here locally (an S3 bucket on AWS); a relative path is under apps/workers
CONTENT_DIR=.data/content
# Onboarding's "import from your AI": locally this uses the Claude Code CLI on your
# machine (your Claude login, no key). Set to "anthropic" to use ANTHROPIC_API_KEY instead.
PROFILE_IMPORTER=claude-cli
# CLAUDE_CLI_PATH=claude
# The letter engine's Claude calls (letter copy, section summaries, the P.S. recap, author cards):
# "claude-cli" (default locally, your Claude login), "anthropic" (ANTHROPIC_API_KEY) or "none"
# (copy from each piece's own words, no model).
LETTER_WRITER=claude-cli
# Optional: stock photos (Unsplash) for pieces without a lead image.
UNSPLASH_ACCESS_KEY=
# "anthropic" enables enrichment (needs ANTHROPIC_API_KEY and AWS credentials for Bedrock)
ENRICHMENT=none
ANTHROPIC_API_KEY=
