{
  "name": "@fs/workers",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "dev": "node --env-file-if-exists=../../.env --experimental-strip-types src/dev.ts",
    "ingest": "node --env-file-if-exists=../../.env --experimental-strip-types src/cli/ingest.ts",
    "discover": "node --env-file-if-exists=../../.env --experimental-strip-types src/cli/discover.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/client-sqs": "^3.1143.0",
    "@fs/ai": "workspace:*",
    "@fs/config": "workspace:*",
    "@fs/core": "workspace:*",
    "@fs/db": "workspace:*",
    "@fs/ingest": "workspace:*",
    "@fs/schema": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
